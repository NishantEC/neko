{
  "name": "tidy",
  "title": "Finished threads leave nothing behind",
  "about": "Ten quick threads in a git project that change nothing leave no worktree folders and no neko/ branches. A thread that leaves an uncommitted file keeps its worktree, and Remove thread refuses with Reveal in Finder.",
  "cli": [
    "fake"
  ],
  "setup": {
    "files": {
      "acme-api": {
        "git": true,
        "files": {
          "README.md": "# Acme\nA small project.\n"
        }
      }
    }
  },
  "steps": [
    {
      "do": "add-workspace",
      "path": "$files/acme-api"
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "role": "button",
          "label_is": "acme-api"
        }
      },
      "expect": "The repository is a project"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "New thread in acme-api"
      }
    },
    {
      "do": "type",
      "text": "Quick look 1 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 1"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 2 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 2"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 3 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 3"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 4 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 4"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 5 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 5"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 6 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 6"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 7 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 7"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 8 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 8"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 9 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 9"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Quick look 10 [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Quick look 10"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 10
    },
    {
      "do": "sleep",
      "secs": 2
    },
    {
      "do": "snap",
      "name": "ten-tasks",
      "expect": "Ten finished threads in acme-api"
    },
    {
      "do": "assert",
      "that": {
        "sh": {
          "run": "git -C files/acme-api worktree list | wc -l | tr -d ' '",
          "is": "1"
        }
      },
      "expect": "No worktree is left: git lists only the person's checkout"
    },
    {
      "do": "assert",
      "that": {
        "sh": {
          "run": "git -C files/acme-api branch --list 'neko/*' | wc -l | tr -d ' '",
          "is": "0"
        }
      },
      "expect": "No neko/ branch is left"
    },
    {
      "do": "key",
      "key": "cmd+n"
    },
    {
      "do": "type",
      "text": "Edit the README [fake:tools]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "allow-until",
      "until": {
        "see": {
          "name": "Worked for"
        }
      },
      "within": 15,
      "expect": "A thread edits files and finishes"
    },
    {
      "do": "sleep",
      "secs": 1.5
    },
    {
      "do": "assert",
      "that": {
        "sh": {
          "run": "git -C files/acme-api worktree list | wc -l | tr -d ' '",
          "is": "2"
        }
      },
      "expect": "Its worktree, with uncommitted files, is kept"
    },
    {
      "do": "click",
      "on": {
        "key": "task-more-button"
      }
    },
    {
      "do": "click",
      "on": {
        "role": "menuitem",
        "name": "Remove thread…"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "remove-task-dialog"
        }
      },
      "expect": "Remove thread asks first"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "Remove",
        "in": {
          "key": "remove-task-dialog"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "refusal-reveal"
        }
      },
      "expect": "It is refused, with Reveal in Finder"
    },
    {
      "do": "snap",
      "name": "refused",
      "expect": "The refusal"
    },
    {
      "do": "assert",
      "that": {
        "all": [
          {
            "sh": {
              "run": "git -C files/acme-api worktree list | wc -l | tr -d ' '",
              "is": "2"
            }
          },
          {
            "see": {
              "role": "option",
              "label": "Edit the README"
            }
          }
        ]
      },
      "expect": "Nothing was deleted: the worktree and the thread are still there"
    }
  ]
}
