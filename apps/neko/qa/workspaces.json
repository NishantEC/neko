{
  "name": "workspaces",
  "title": "Projects as sidebar sections",
  "about": "Two folders are added as projects (one a git repository). Both appear as groups, with No project last once a thread exists. A thread runs in each and one in No project; each sits under its own section with the right header. A section is folded; after a quit and relaunch the fold and everything else is as it was.",
  "cli": [
    "fake"
  ],
  "window": true,
  "setup": {
    "files": {
      "acme-api": {
        "git": true,
        "files": {
          "README.md": "# Acme\n"
        }
      },
      "mochi-notes": {
        "files": {
          "notes.md": "Notes\n"
        }
      }
    }
  },
  "steps": [
    {
      "do": "add-workspace",
      "path": "$files/acme-api"
    },
    {
      "do": "add-workspace",
      "path": "$files/mochi-notes"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "role": "button",
              "label_is": "acme-api"
            }
          },
          {
            "see": {
              "role": "button",
              "label_is": "mochi-notes"
            }
          }
        ]
      },
      "expect": "Both projects appear as groups (No project is listed once a thread exists)"
    },
    {
      "do": "snap",
      "name": "sections",
      "expect": "The sidebar with two project groups"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "New thread in acme-api"
      }
    },
    {
      "do": "type",
      "text": "Check the API [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Check the API"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "expect": "A thread runs in acme-api"
    },
    {
      "do": "assert",
      "that": {
        "all": [
          {
            "see": {
              "key": "task-workspace",
              "text": "acme-api"
            }
          },
          {
            "see": {
              "role": "option",
              "label": "Check the API",
              "in": {
                "role": "group",
                "label_is": "acme-api"
              }
            }
          }
        ]
      },
      "expect": "It sits under acme-api; the band names acme-api"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "New thread in mochi-notes"
      }
    },
    {
      "do": "type",
      "text": "Sort the notes [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Sort the notes"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "expect": "A thread runs in mochi-notes"
    },
    {
      "do": "assert",
      "that": {
        "all": [
          {
            "see": {
              "key": "task-workspace",
              "text": "mochi-notes"
            }
          },
          {
            "see": {
              "role": "option",
              "label": "Sort the notes",
              "in": {
                "role": "group",
                "label_is": "mochi-notes"
              }
            }
          },
          {
            "title": "Sort the notes [fake:plain] — mochi-notes"
          }
        ]
      },
      "expect": "It sits under mochi-notes; the band and the window's title name it"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "New thread in No project"
      }
    },
    {
      "do": "type",
      "text": "Plan lunch [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Plan lunch"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "expect": "A thread runs in No project"
    },
    {
      "do": "assert",
      "that": {
        "all": [
          {
            "see": {
              "key": "task-workspace",
              "text": "No project"
            }
          },
          {
            "see": {
              "role": "option",
              "label": "Plan lunch",
              "in": {
                "role": "group",
                "label_is": "No project"
              }
            }
          }
        ]
      },
      "expect": "It sits under No project"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "acme-api"
      }
    },
    {
      "do": "wait",
      "until": {
        "gone": {
          "role": "option",
          "label": "Check the API"
        }
      },
      "expect": "Pressing the acme-api header folds its section"
    },
    {
      "do": "snap",
      "name": "folded",
      "expect": "acme-api folded"
    },
    {
      "do": "quit-app"
    },
    {
      "do": "start-app"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "role": "button",
              "label_is": "acme-api"
            }
          },
          {
            "see": {
              "role": "option",
              "label": "Sort the notes",
              "in": {
                "role": "group",
                "label_is": "mochi-notes"
              }
            }
          },
          {
            "see": {
              "role": "option",
              "label": "Plan lunch",
              "in": {
                "role": "group",
                "label_is": "No project"
              }
            }
          }
        ]
      },
      "within": 15,
      "expect": "After a relaunch the sections and their threads are back"
    },
    {
      "do": "assert",
      "that": {
        "gone": {
          "role": "option",
          "label": "Check the API"
        }
      },
      "expect": "acme-api is still folded after the relaunch"
    },
    {
      "do": "snap",
      "name": "relaunched",
      "expect": "The sidebar after the relaunch"
    }
  ]
}
