{
  "name": "rounds",
  "title": "Rounds: make one, run it now, see where its thread came from, switch it off, remove it",
  "about": "New round… on the Rounds page, with mochi picked, makes a round (every 6 hours, in the acme-api project). Run now makes an ordinary thread: it appears under acme-api, is mochi's, and says it came from the round. The round's history shows how it ended. Switching the round off is said on its card. Removing it asks first; its thread stays.",
  "cli": [
    "fake"
  ],
  "setup": {
    "files": {
      "acme-api": {
        "git": true,
        "files": {
          "README.md": "# Acme\n"
        }
      }
    }
  },
  "steps": [
    {
      "do": "add-workspace",
      "path": "$files/acme-api"
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "role": "button",
          "label_is": "acme-api"
        }
      },
      "within": 15,
      "expect": "acme-api is a project"
    },
    {
      "do": "key",
      "key": "cmd+3"
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "rounds-new-empty"
        }
      },
      "within": 15,
      "expect": "Rounds says what it is and offers New round…"
    },
    {
      "do": "click",
      "on": {
        "key": "rounds-new-empty"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-name-input"
        }
      },
      "within": 15,
      "expect": "The New round panel opens"
    },
    {
      "do": "click",
      "on": {
        "key": "round-cat"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-cat-menu-item*",
          "label": "mochi"
        }
      },
      "within": 15,
      "expect": "The cat menu opens above the panel"
    },
    {
      "do": "click",
      "on": {
        "key": "round-cat-menu-item*",
        "label": "mochi"
      }
    },
    {
      "do": "click",
      "on": {
        "key": "round-name-input"
      }
    },
    {
      "do": "type",
      "text": "Docs check"
    },
    {
      "do": "click",
      "on": {
        "key": "round-words-input"
      }
    },
    {
      "do": "type",
      "text": "Check the docs [fake:plain]"
    },
    {
      "do": "click",
      "on": {
        "key": "round-workspace"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-workspace-menu-item*",
          "label": "acme-api"
        }
      },
      "within": 15,
      "expect": "The project menu opens"
    },
    {
      "do": "click",
      "on": {
        "key": "round-workspace-menu-item*",
        "label": "acme-api"
      }
    },
    {
      "do": "click",
      "on": {
        "key": "round-kind-2"
      }
    },
    {
      "do": "sleep",
      "secs": 0.4
    },
    {
      "do": "snap",
      "name": "new-round",
      "expect": "The panel: name, words, mochi, acme-api, every 6 hours, and what that means"
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-first",
          "text": "then every 6 hours"
        }
      },
      "within": 15,
      "expect": "It says when the first run will be"
    },
    {
      "do": "click",
      "on": {
        "key": "round-save"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-*-run"
        }
      },
      "within": 15,
      "expect": "The round is on the Rounds page"
    },
    {
      "do": "snap",
      "name": "round-made",
      "expect": "The Rounds page lists the new round"
    },
    {
      "do": "click",
      "on": {
        "key": "round-*-run"
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "round-*-last-words",
              "text": "Last: done"
            }
          },
          {
            "see": {
              "key": "thread-*",
              "label": "Docs check"
            }
          }
        ]
      },
      "within": 20,
      "expect": "Run now made a thread and it finished"
    },
    {
      "do": "snap",
      "name": "run-now",
      "expect": "The round says it last went Done"
    },
    {
      "do": "click",
      "on": {
        "key": "round-*-open"
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "task-round",
              "label": "From the round Docs check, run by hand"
            }
          },
          {
            "see": {
              "key": "band-title",
              "text": "Docs check"
            }
          },
          {
            "see": {
              "key": "task-workspace",
              "text": "acme-api"
            }
          },
          {
            "see": {
              "key": "task-cat",
              "label": "mochi"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "within": 15,
      "expect": "The thread is mochi's, in acme-api, and says where it came from"
    },
    {
      "do": "snap",
      "name": "task-from-round",
      "expect": "The thread says it is from the round Docs check"
    },
    {
      "do": "key",
      "key": "cmd+3"
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "rounds-title"
        }
      },
      "within": 15,
      "expect": "⌘3 opens Rounds"
    },
    {
      "do": "click",
      "on": {
        "key": "round-*-history-trigger"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-*-history-list",
          "label": "History of Docs check"
        }
      },
      "within": 15,
      "expect": "The history opens"
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-*-last-words",
          "text": "Last: done"
        }
      },
      "within": 15,
      "expect": "The card says the last run is done"
    },
    {
      "do": "snap",
      "name": "history",
      "expect": "The card with its history: Run now, Done"
    },
    {
      "do": "click",
      "on": {
        "key": "round-*-switch"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "round-*-switch",
          "label": "Docs check is off"
        }
      },
      "within": 15,
      "expect": "The switch is off"
    },
    {
      "do": "snap",
      "name": "off",
      "expect": "The round is off"
    },
    {
      "do": "click",
      "on": {
        "key": "round-*-menu"
      }
    },
    {
      "do": "click",
      "on": {
        "role": "menuitem",
        "name": "Remove…"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "role": "button",
          "label_is": "Remove",
          "in": {
            "key": "remove-round-dialog"
          }
        }
      },
      "within": 15,
      "expect": "Removing asks first"
    },
    {
      "do": "snap",
      "name": "remove-asks",
      "expect": "The panel says the threads it made stay"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "Remove",
        "in": {
          "key": "remove-round-dialog"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "rounds-empty"
            }
          },
          {
            "see": {
              "key": "thread-*",
              "label": "Docs check"
            }
          }
        ]
      },
      "within": 15,
      "expect": "The round is gone and its thread is still in the sidebar"
    },
    {
      "do": "snap",
      "name": "removed",
      "expect": "No rounds; the thread stays"
    }
  ]
}
