{
  "name": "cats",
  "title": "Cats: standing rules, new and retired cats",
  "about": "Three starter cats exist and none is at work: the sidebar has no Cattains section, and a thread has no cat. Rules written on mochi's page are saved. New cat… in Settings ▸ Cats makes a fourth, and it is not at work either. Retire asks first, its page goes quiet, and Settings ▸ Cats offers Bring back. (What a cat's rules do to a run is covered by the daemon's and the app's tests: only work a cat was given, such as a round's, carries them.)",
  "cli": [
    "fake"
  ],
  "setup": {
    "daemon_env": {
      "NEKO_FAKE_RECORD": "$work/fake-record.jsonl"
    }
  },
  "steps": [
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cats",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "settings-cat-*",
              "label": "miso"
            }
          },
          {
            "see": {
              "key": "settings-cat-*",
              "label": "mochi"
            }
          },
          {
            "see": {
              "key": "settings-cat-*",
              "label": "tofu"
            }
          }
        ]
      },
      "within": 10,
      "expect": "Settings > Cats lists the three starter cats"
    },
    {
      "do": "assert",
      "that": {
        "gone": {
          "key": "cattains-section"
        }
      },
      "expect": "No cat is at work: the sidebar has no Cattains section"
    },
    {
      "do": "click",
      "on": {
        "key": "settings-cat-cat_mochi-open"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cat-rules"
        }
      },
      "expect": "mochi's page opens with its rules"
    },
    {
      "do": "click",
      "on": {
        "key": "cat-rules-input"
      }
    },
    {
      "do": "type",
      "text": "QA-RULE-7: Answer in one short paragraph."
    },
    {
      "do": "click",
      "on": {
        "key": "cat-save"
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "gone": {
              "key": "cat-unsaved"
            }
          },
          {
            "see": {
              "key": "cat-rules-input",
              "text": "QA-RULE-7"
            }
          }
        ]
      },
      "within": 5,
      "expect": "Save keeps the rules"
    },
    {
      "do": "snap",
      "name": "mochi-page",
      "expect": "mochi's page with its rules"
    },
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cats",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "click",
      "on": {
        "key": "settings-new-cat"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cat-name-input"
        }
      }
    },
    {
      "do": "type",
      "text": "nori"
    },
    {
      "do": "click",
      "on": {
        "key": "cat-name-save"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cat-title",
          "text": "nori"
        }
      },
      "within": 5,
      "expect": "New cat… in Settings makes a fourth cat, nori, and its page opens"
    },
    {
      "do": "assert",
      "that": {
        "gone": {
          "key": "cat-cat_*",
          "label": "nori"
        }
      },
      "expect": "nori is napping: not in the Cattains"
    },
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cats",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "click",
      "on": {
        "key": "settings-cat-cat_mochi-open"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cat-retire"
        }
      }
    },
    {
      "do": "click",
      "on": {
        "key": "cat-retire"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "retire-cat-dialog"
        }
      },
      "expect": "Retire asks first"
    },
    {
      "do": "snap",
      "name": "retire-asks",
      "expect": "The question"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "Retire",
        "in": {
          "key": "retire-cat-dialog"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "gone": {
          "key": "retire-cat-dialog"
        }
      }
    },
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cats",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "role": "button",
          "name": "Bring back"
        }
      },
      "expect": "Settings ▸ Cats offers Bring back"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "name": "Bring back"
      }
    },
    {
      "do": "wait",
      "until": {
        "gone": {
          "role": "button",
          "name": "Bring back"
        }
      },
      "within": 5
    }
  ]
}
