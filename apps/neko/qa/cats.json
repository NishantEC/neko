{
  "name": "cats",
  "title": "Cattains: made, changed and retired in Settings and their Profile",
  "about": "Three starter Cattains exist and none is at work: the sidebar has no Cattains section, and a thread has no cat. mochi's RULES.md is written in its Files tab and saved. New Cattain… in Settings ▸ Cattains makes a fourth, whose own thread opens on its Profile; it is not at work either. Retire asks first, its Profile says so, and Settings ▸ Cattains offers Bring back. (What a Cattain's files do to a run is covered by cattain-thread, cattain-files and the daemon's and app's tests.)",
  "cli": [
    "fake"
  ],
  "size": [
    1300,
    860
  ],
  "setup": {
    "daemon_env": {
      "NEKO_FAKE_RECORD": "$work/fake-record.jsonl"
    }
  },
  "steps": [
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cattains",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "settings-cat-*",
              "label": "miso"
            }
          },
          {
            "see": {
              "key": "settings-cat-*",
              "label": "mochi"
            }
          },
          {
            "see": {
              "key": "settings-cat-*",
              "label": "tofu"
            }
          }
        ]
      },
      "within": 10,
      "expect": "Settings > Cattains lists the three starters"
    },
    {
      "do": "assert",
      "that": {
        "gone": {
          "key": "cattains-section"
        }
      },
      "expect": "No Cattain is at work: the sidebar has no Cattains section"
    },
    {
      "do": "click",
      "on": {
        "key": "settings-cat-cat_mochi-open"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "band-title",
          "text": "mochi"
        }
      },
      "within": 10,
      "expect": "mochi's own thread opens"
    },
    {
      "do": "click",
      "on": {
        "key": "cattain-file-chip-rules"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cattain-file-input"
        }
      },
      "within": 10
    },
    {
      "do": "click",
      "on": {
        "key": "cattain-file-input"
      }
    },
    {
      "do": "type",
      "text": "QA-RULE-7: Answer in one short paragraph."
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cattain-file-unsaved"
        }
      },
      "within": 5,
      "expect": "Unsaved changes say so"
    },
    {
      "do": "click",
      "on": {
        "key": "cattain-file-save"
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "gone": {
              "key": "cattain-file-unsaved"
            }
          },
          {
            "see": {
              "key": "cattain-file-input",
              "text": "QA-RULE-7: A"
            }
          }
        ]
      },
      "within": 5,
      "expect": "Save keeps RULES.md"
    },
    {
      "do": "snap",
      "name": "mochi-rules",
      "expect": "mochi's RULES.md"
    },
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cattains",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "click",
      "on": {
        "key": "settings-new-cat"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cat-name-input"
        }
      }
    },
    {
      "do": "type",
      "text": "nori"
    },
    {
      "do": "click",
      "on": {
        "key": "cat-name-save"
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "cat-title",
              "text": "nori"
            }
          },
          {
            "see": {
              "key": "band-title",
              "text": "nori"
            }
          }
        ]
      },
      "within": 5,
      "expect": "New Cattain… makes a fourth, nori, and its own thread opens on its Profile"
    },
    {
      "do": "assert",
      "that": {
        "gone": {
          "key": "cat-cat_*",
          "label": "nori"
        }
      },
      "expect": "nori is napping: not in the sidebar's Cattains"
    },
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cattains",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "click",
      "on": {
        "key": "settings-cat-cat_mochi-open"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "band-title",
          "text": "mochi"
        }
      },
      "within": 5
    },
    {
      "do": "click",
      "on": {
        "role": "tab",
        "name": "Profile"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "cat-retire"
        }
      },
      "within": 5
    },
    {
      "do": "click",
      "on": {
        "key": "cat-retire"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "key": "retire-cat-dialog"
        }
      },
      "expect": "Retire asks first"
    },
    {
      "do": "snap",
      "name": "retire-asks",
      "expect": "The question"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "label_is": "Retire",
        "in": {
          "key": "retire-cat-dialog"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "gone": {
              "key": "retire-cat-dialog"
            }
          },
          {
            "see": {
              "key": "band-purpose",
              "text": "Retired"
            }
          },
          {
            "see": {
              "key": "cat-bring-back"
            }
          }
        ]
      },
      "within": 5,
      "expect": "Its thread stays open and says it is retired; its Profile offers Bring back"
    },
    {
      "do": "key",
      "key": "cmd+,"
    },
    {
      "do": "click",
      "on": {
        "name": "Cattains",
        "in": {
          "key": "settings-page"
        }
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "role": "button",
          "name": "Bring back"
        }
      },
      "expect": "Settings ▸ Cattains offers Bring back"
    },
    {
      "do": "click",
      "on": {
        "role": "button",
        "name": "Bring back"
      }
    },
    {
      "do": "wait",
      "until": {
        "gone": {
          "role": "button",
          "name": "Bring back"
        }
      },
      "within": 5
    }
  ]
}
