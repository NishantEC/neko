{
  "name": "narrow",
  "title": "The first thread in the smallest window",
  "about": "At 760 by 560 points the sidebar is folded. The first-thread journey works; the sidebar can be shown and hidden again with the band's button.",
  "cli": [
    "fake"
  ],
  "size": [
    760,
    560
  ],
  "steps": [
    {
      "do": "snap",
      "name": "narrow-home",
      "expect": "Home at the smallest size, sidebar folded"
    },
    {
      "do": "assert",
      "that": {
        "all": [
          {
            "gone": {
              "key": "sidebar"
            }
          },
          {
            "see": {
              "key": "sidebar-show"
            }
          }
        ]
      },
      "expect": "The sidebar is folded and the band offers Show sidebar"
    },
    {
      "do": "click",
      "on": {
        "key": "composer-input"
      }
    },
    {
      "do": "type",
      "text": "Water the plants [fake:plain]"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "until": {
        "all": [
          {
            "see": {
              "key": "band-title",
              "text": "Water the plants"
            }
          },
          {
            "see": {
              "name": "Worked for"
            }
          }
        ]
      },
      "expect": "The thread opens and finishes in the narrow window"
    },
    {
      "do": "snap",
      "name": "narrow-task",
      "expect": "The thread at the smallest size"
    },
    {
      "do": "click",
      "on": {
        "key": "sidebar-show"
      }
    },
    {
      "do": "wait",
      "until": {
        "see": {
          "role": "option",
          "label": "Water the plants"
        }
      },
      "expect": "Show sidebar shows it, with the thread"
    },
    {
      "do": "sleep",
      "secs": 0.6
    },
    {
      "do": "snap",
      "name": "narrow-sidebar",
      "expect": "The sidebar shown in the narrow window"
    },
    {
      "do": "assert",
      "that": {
        "see": {
          "key": "band-title",
          "text": "Water the plants"
        }
      },
      "expect": "With the sidebar shown at 760 wide the band still shows the whole title"
    },
    {
      "do": "click",
      "on": {
        "key": "sidebar-hide"
      }
    },
    {
      "do": "wait",
      "until": {
        "gone": {
          "key": "sidebar"
        }
      },
      "expect": "Hide sidebar folds it again"
    }
  ]
}
