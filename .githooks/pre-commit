#!/bin/bash
# Compile check before a commit lands on main. Skips commits that touch no
# Rust or Swift. Installed by `git config core.hooksPath .githooks`.
# Bypass once with `git commit --no-verify` (Neko's own publisher does).
set -euo pipefail
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(rs|swift)$|(^|/)Cargo\.(toml|lock)$|Package\.swift$'; then
  exec "$(git rev-parse --show-toplevel)/scripts/check.sh" --quick
fi
